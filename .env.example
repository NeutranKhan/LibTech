# Canonical public origin; required in production (HTTPS).
APP_URL=http://127.0.0.1:3000

# Firebase web application configuration (public identifiers, not Admin secrets)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin: prefer Application Default Credentials on Google hosting.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# For a non-Google server, provide these secrets instead of ADC:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional AI grading. Both must be present. Choose an available model supporting
# Responses API Structured Outputs and verify its cost in your OpenAI account.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_FEEDBACK_ENABLED=false
PROFILE_PHOTOS_ENABLED=false

# Optional overrides for the public details in src/lib/site.ts. Review policies before launch.
OPERATOR_NAME=
SUPPORT_EMAIL=
REFUND_POLICY=
DATA_RETENTION_POLICY=
